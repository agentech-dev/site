---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry, GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const pathname = `/blog/${entry.id}`;
const iso = entry.data.date.toISOString().slice(0, 10);
---
<Base title={entry.data.title} description={entry.data.description} pathname={pathname}>
  <article>
    <header>
      <h1>{entry.data.title}</h1>
      <p><time datetime={iso}>{iso}</time></p>
    </header>
    <Content />
    <hr />
    <p><a href="/blog">Back to blog index</a></p>
  </article>
</Base>
